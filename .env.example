# Copy to .env and fill in. All are optional — the app runs fully in mock/demo
# mode without them, which is how you develop in Expo Go.

# Scan backend (the keep-backend Cloudflare Worker URL, no trailing slash)
EXPO_PUBLIC_SCAN_URL=
# Shared secret matching the Worker's APP_TOKEN (blocks random abuse of your Anthropic key)
EXPO_PUBLIC_SCAN_TOKEN=

# RevenueCat public Apple API key (starts with appl_). Only used in dev-client/EAS builds.
EXPO_PUBLIC_RC_API_KEY=

# PostHog project API key (starts with phc_)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
